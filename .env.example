# Server Configuration
PORT=3000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL=

# Shared application session
JWT_SECRET=
VITE_APP_ID=

# Google OAuth (create Web application credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/google/callback

# LINE Login (LINE Developers Console > LINE Login channel)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/line/callback

# Optional legacy Manus integration (used only by scheduled-task compatibility)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Storage & Backend Integrations (Optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google Sheets is intentionally disabled until per-user Google token storage
# and per-user spreadsheet ownership are implemented. Do not configure a
# shared BACKEND_ADMIN_API_KEY for multi-user access.
