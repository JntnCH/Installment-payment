# Server Configuration
PORT=3000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL=

# Shared application session
JWT_SECRET=

# Google OAuth (create Web application credentials in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/google/callback

# LINE Login (LINE Developers Console > LINE Login channel)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/line/callback

# Telegram Mini App authentication (BotFather bot token; keep secret)
TELEGRAM_BOT_TOKEN=

# Optional legacy Manus integration (only required for legacy scheduled tasks)
MANUS_PROJECT_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Storage & Backend Integrations (Optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Google Sheets Auto Sync (per-user OAuth; spreadsheet ID is set in the app)
# Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
