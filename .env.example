# Server Configuration
PORT=3000
NODE_ENV=development

# Database (Cloud SQL / MySQL) - Optional, fallback to in-memory store if unset
DATABASE_URL=

# Auth & Session Configuration
JWT_SECRET=
OWNER_OPEN_ID=
OAUTH_SERVER_URL=

# Storage & Backend Integrations (Optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Client Environment Variables
VITE_APP_ID=
VITE_BACKEND_API_URL=https://income-and-expenses-by-manus-production.up.railway.app
VITE_OAUTH_PORTAL_URL=

# Optional: set at runtime in browser for admin-protected backend calls
# window.INSTALLMENT_BACKEND_URL = VITE_BACKEND_API_URL
# window.INSTALLMENT_ADMIN_API_KEY = <ADMIN_API_KEY from Railway backend>
